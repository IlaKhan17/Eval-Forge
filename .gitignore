# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
coverage.xml
dist/
build/

# Node
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# Secrets and local config — never commit these
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# EvalForge local state
.evalforge/
~/.evalforge/
# Reports a local run drops in the working tree. The name comes from the suite, so the pattern has
# to cover all of them rather than the default filename only.
evalforge-*.json
*.evalforge.local.yaml

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Docker volumes
.docker-data/

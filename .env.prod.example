# Production configuration for docker-compose.prod.yml.
#
#   ./scripts/init_secrets.sh      # copies this file to .env.prod and fills in the owner password
#
# Secrets are NOT here — they live in ./secrets/ as files, created by scripts/init_secrets.sh. The
# one exception is OWNER_DB_PASSWORD, and only because a connection string cannot reference a file.

# Keeps this stack's containers and volumes separate from the development stack in
# docker-compose.yml, which is also called `proofstep`.
COMPOSE_PROJECT_NAME=proofstep-prod

# Images. Pin a version rather than tracking `latest` in anything you care about: `latest` means a
# restart can change the code without a deploy, which is how a working system breaks at 3am.
PROOFSTEP_TAG=latest

# The database owner — runs migrations, owns the schema, and is *not* what the application uses.
OWNER_DB_USER=proofstep
# Must match the contents of secrets/owner_db_password exactly. init_secrets.sh does this for you;
# if you are writing this file by hand, copy the value rather than generating a second one.
OWNER_DB_PASSWORD=replace-me-with-the-contents-of-secrets/owner_db_password

# The application role: no DDL, no ownership, subject to every row-level-security policy.
APP_DB_USER=proofstep_app
POSTGRES_DB=proofstep

# Object storage for large span payloads.
S3_ACCESS_KEY=proofstep
S3_BUCKET=proofstep-payloads

# Where the dashboard listens on the host. Put your own TLS-terminating proxy in front of it; the
# API is deliberately not published.
WEB_PORT=3000

# The public address of the dashboard. Password reset links are built from this, so a wrong value
# produces links that go nowhere — and it must not be guessed from the request, because a link built
# from a caller-supplied Host header points wherever the caller said, with a live token attached.
DASHBOARD_URL=http://localhost:3000

# Origins allowed to call the API directly from a browser. Empty is correct when only the dashboard
# talks to it, which is the default topology.
CORS_ORIGINS=

# The proxy in front of the stack, as a CIDR. Without this, X-Forwarded-For is caller-controlled and
# every client address in the audit log is fiction. Narrow it to your proxy.
FORWARDED_ALLOW_IPS=0.0.0.0/0
